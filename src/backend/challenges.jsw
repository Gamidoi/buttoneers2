
import wixData from 'wix-data';
import { currentMember } from 'wix-members-backend';

const COLLECTION = 'Challenges';

export async function getChallenges() {
  const result = await wixData.query(COLLECTION)
    .descending('_createdDate')
    .find({ suppressAuth: true });
  return result.items;
}


export async function insertChallenge(month, title, content, imageUrl = null) {
  const member = await currentMember.getMember();
  if (!member) throw new Error('Not authenticated');
  const roles = await currentMember.getRoles();
  if (!roles.some(r => r.title === 'Admin') && !roles.some(r => r.title === 'Moderator')) {
    throw new Error('Access denied');
  }

  const authorName = member.profile?.nickname || member.profile?.name?.first || 'Admin';
  const item = await wixData.insert(COLLECTION, {
    month,
    title,
    content,
    authorId: member._id,
    authorName,
    ...(imageUrl && { imageUrl })
  }, { suppressAuth: true });
  return { success: true, challengeId: item._id };
}
